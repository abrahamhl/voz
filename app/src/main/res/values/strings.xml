    <!-- Accessibility service -->
    <string name="a11y_service_label">VOZ voice control</string>
    <string name="a11y_service_description">VOZ reads the screen and acts on it only when you give a voice command: open apps, search, tap buttons, scroll, type and read comments. It has no accounts, no analytics and no servers. Everything runs on your phone unless you turn on the optional cloud brain.</string>

