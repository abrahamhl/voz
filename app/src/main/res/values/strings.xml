    <!-- Onboarding -->
    <string name="onb_step">Step %1$d of %2$d</string>
    <string name="onb_title_mic">Microphone</string>
    <string name="onb_body_mic">VOZ only listens after you tap the mic. Your phone’s speech service turns your voice into text.</string>
    <string name="onb_btn_mic">Allow microphone</string>
    <string name="onb_title_overlay">Floating mic</string>
    <string name="onb_body_overlay">A small mic button floats over other apps, so you can talk to VOZ from anywhere.</string>
    <string name="onb_btn_overlay">Allow display over other apps</string>
    <string name="onb_title_a11y">Accessibility service</string>
    <string name="onb_body_a11y">VOZ needs its accessibility service to read the screen and to tap, scroll and type for you. It only acts when you ask.</string>
    <string name="onb_restricted_title">Installed the APK yourself? (Android 13 and later)</string>
    <string name="onb_restricted_steps">1. Tap “Open app info”.\n2. Tap the ⋮ menu in the top corner.\n3. Tap “Allow restricted settings” and confirm.\n4. Come back, tap “Open accessibility settings” and turn on VOZ voice control.</string>
    <string name="onb_btn_app_info">Open app info</string>
    <string name="onb_btn_a11y">Open accessibility settings</string>
    <string name="onb_title_cloud">Cloud brain (optional)</string>
    <string name="onb_body_cloud">VOZ works offline. To understand free-form requests it can use Google Gemini with your own API key. The key is stored encrypted on this phone, and the cloud stays off until you turn it on in Settings.</string>
    <string name="onb_key_label">Gemini API key</string>
